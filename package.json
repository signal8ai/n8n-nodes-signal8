{
	"name": "n8n-nodes-signal8",
	"version": "0.1.4",
	"description": "n8n nodes for the Signal8 public API: company quotes, insider transactions, dilution snapshots, material SEC filings, trading halts and congressional trades.",
	"license": "MIT",
	"homepage": "https://signal8.ai",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"signal8",
		"sec",
		"edgar",
		"sec-filings",
		"insider-trading",
		"trading-halts",
		"congress-trades",
		"stocks"
	],
	"author": {
		"name": "Signal8 AI, Inc.",
		"email": "support@signal8.ai",
		"url": "https://signal8.ai"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/signal8ai/n8n-nodes-signal8.git"
	},
	"bugs": {
		"url": "https://github.com/signal8ai/n8n-nodes-signal8/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test test/*.test.js",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/Signal8Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/Signal8/Signal8.node.js",
			"dist/nodes/Signal8Trigger/Signal8Trigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.54.6",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
